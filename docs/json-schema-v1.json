{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tool result envelope version 1",
  "type": "object",
  "required": ["schema_version", "outcome", "code", "data", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "outcome": { "enum": ["success", "partial_success", "unsupported", "failure"] },
    "code": { "type": "string" },
    "data": { "type": "object" },
    "message": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
